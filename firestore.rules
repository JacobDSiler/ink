rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each author owns their own subtree. Everything else is Worker-only (service account).
    match /authors/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /campaigns/{cid}/recipients/{sid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Worker only
      }
    }

    // Worker-only root collections
    match /slugs/{slug} { allow read: if request.auth != null; allow write: if false; }
    match /jobs/{id} { allow read, write: if false; }
    match /schedule/{id} { allow read, write: if false; }
    match /automationRuns/{id} { allow read, write: if false; }
    match /emailIndex/{id} { allow read, write: if false; }
  }
}
